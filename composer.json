{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "linkado-ru/laravel",
    "description": "Laravel integration for the Linkado affiliate platform.",
    "keywords": [
        "laravel",
        "linkado-ru"
    ],
    "homepage": "https://github.com/linkado-ru/laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "everully",
            "email": "everully@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "linkado-ru/php-sdk": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Linkado\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Linkado\\Laravel\\Tests\\": "tests/",
            "Linkado\\Laravel\\Database\\Factories\\": "database/factories/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@clear",
            "@prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "rector": [
            "vendor/bin/rector process"
        ],
        "rector:check": [
            "vendor/bin/rector process --dry-run"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@rector:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Linkado\\Laravel\\LinkadoServiceProvider"
            ],
            "aliases": {
                "Linkado": "Linkado\\Laravel\\Facades\\Linkado"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
